{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "products-grid-block/products-grid",
  "version": "1.0.0",
  "title": "Products Grid",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Display products in a responsive grid layout with images, titles, descriptions, and links.",
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "textdomain": "products-grid-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "attributes": {
    "products": {
      "type": "array",
      "default": []
    },
    "columns": {
      "type": "number",
      "default": 4
    }
  }
}
